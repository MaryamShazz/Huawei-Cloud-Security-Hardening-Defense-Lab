{
  "description": "Example account password policy. Values reflect a reasonable baseline, adjust to organizational requirements.",
  "minimum_length": 12,
  "require_uppercase": true,
  "require_lowercase": true,
  "require_number": true,
  "require_special_character": true,
  "password_rotation_days": 90,
  "password_history_reuse_limit": 5,
  "max_login_failures_before_lockout": 5,
  "lockout_duration_minutes": 30,
  "mfa_required_for_console_login": true
}
